{
  "name": "sisters-promise",
  "version": "1.0.0",
  "description": "Natural skincare website for Sister's Promise - handmade, clean skincare crafted with intention and care",
  "main": "server.js",
  "directories": {
    "example": "root"
  },
  "scripts": {
    "open-app": "gulp open-app",
    "start": "node server.js",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run open-app\"",
    "build": "node build.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:verbose": "jest --forceExit --detectOpenHandles --verbose",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage",
    "watch": "gulp-watch",
    "lint": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derob357/sisters-promise.git"
  },
  "keywords": [
    "sisters promise",
    "natural skincare",
    "organic products",
    "sea moss soap",
    "skincare website",
    "handmade lotions",
    "skin scrubs",
    "clean beauty",
    "bootstrap 5",
    "responsive design"
  ],
  "author": "Sister's Promise",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/derob357/sisters-promise/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^7.6.0",
    "eslint": "^10.0.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^7.0.1",
    "gulp-clean": "^0.4.0",
    "gulp-install": "^1.1.0",
    "gulp-open": "^3.0.1",
    "gulp-sass": "^5.1.0",
    "gulp-sourcemaps": "^2.6.5",
    "jest": "^30.2.0",
    "sass": "^1.49.9"
  },
  "homepage": "https://sisterspromise.com",
  "dependencies": {
    "@google-cloud/recaptcha-enterprise": "^6.3.1",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.8",
    "node-fetch": "^2.6.11",
    "nodemailer": "^6.9.7",
    "square": "^28.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "ws": "^8.14.2"
  }
}
