# Square API Configuration for Sisters Promise
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - it contains sensitive data!

# Get these from: https://squareup.com/dashboard → Developer → Applications
SQUARE_APPLICATION_ID=temp_app_id_placeholder
SQUARE_ACCESS_TOKEN=temp_access_token_placeholder
SQUARE_LOCATION_ID=temp_location_id_placeholder

# Environment: 'sandbox' for testing, 'production' for real transactions
SQUARE_ENVIRONMENT=sandbox

# reCAPTCHA Enterprise Configuration
# Get these from: https://console.cloud.google.com/security/recaptcha
GOOGLE_CLOUD_PROJECT_ID=your-project-id
RECAPTCHA_ENTERPRISE_KEY=your_recaptcha_enterprise_key
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Server Configuration
NODE_ENV=development
PORT=3000
HTTPS_PORT=443

# HTTPS/TLS Configuration
# Certificates are generated automatically by generate-certs.js
# For production, use proper certificates from Let's Encrypt or a trusted CA
USE_HTTPS=true
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# Allowed origins for CORS (comma-separated)
# Should use HTTPS in production
ALLOWED_ORIGINS=https://localhost:443,https://localhost:3000,http://localhost:3000

# Email Settings
SMTP_FROM=info@sisterspromise.com
REPLY_TO_EMAIL=info@sisterspromise.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDGRID_API_KEY=optional-sendgrid-key
EMAIL_PROVIDER=smtp
APP_URL=https://sisterspromise.com

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/sisters-promise
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Authentication
JWT_SECRET=your-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Default User Credentials (Change these in production!)
OWNER_PASSWORD=***REMOVED***
ADMIN_PASSWORD=***REMOVED***

# Google Analytics 4 Configuration
# Get these from: https://analytics.google.com → Admin → Data Streams
GA_MEASUREMENT_ID=G_XXXXXXXXXX
GA_API_SECRET=your-ga4-api-secret-key
# Apple Analytics Configuration
# For native iOS/macOS apps, configure in Xcode
# For web tracking on iOS, GA4 measurements apply automatically
